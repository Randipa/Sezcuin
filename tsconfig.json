{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@pulumi/aws": ["./.sst/platform/node_modules/@pulumi/aws"],
      "@pulumi/pulumi": ["./.sst/platform/node_modules/@pulumi/pulumi"]
    }
  },
  "include": ["sst.config.ts", "infra/**/*.ts"]
}
