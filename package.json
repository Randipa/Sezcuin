{
  "name": "sezcuin",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "prepare": "node scripts/prepare-husky.mjs",
    "lint:ci": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && npx eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "lint:frontend": "cd frontend && npx eslint src --max-warnings 0",
    "typecheck": "npm exec --workspace=backend -- tsc --noEmit && npm exec --workspace=frontend -- tsc --noEmit",
    "test:backend": "npm test --workspace=backend -- --ci",
    "ci:check": "npm run lint:ci && npm run typecheck && npm run test:backend && npm run build --workspace=backend && npm run build --workspace=frontend",
    "dev:sst": "sst dev",
    "deploy:sst": "npm run build --workspace=backend && sst deploy",
    "deploy:production": "npm run build --workspace=backend && sst deploy --stage production",
    "remove:sst": "sst remove",
    "remove:saliya": "sst remove --stage saliya",
    "remove:runner": "sst remove --stage runner",
    "remove:production": "sst remove --stage production",
    "seed:aws": "bash scripts/invoke-seed.sh \"${STAGE:-saliya}\"",
    "seed:production": "STAGE=production npm run seed:aws",
    "setup:github-oidc": "bash scripts/setup-github-oidc-role.sh",
    "check:ses": "bash scripts/check-ses.sh",
    "sync:secrets:production": "bash scripts/sync-sst-secrets.sh production",
    "sst:install": "sst install"
  },
  "devDependencies": {
    "@pulumi/aws": "^7.36.0",
    "@pulumi/pulumi": "^3.252.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "sst": "^4.17.1",
    "typescript": "^5.7.3"
  }
}
